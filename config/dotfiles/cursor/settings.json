{
  "cursor.composer.codeBlockWordWrap": true,
  "cursor.composer.conversationDensity": "detailed",
  "cursor.composer.editorConversationDensity": "compact-ungrouped",
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "cursor.cpp.disabledLanguages": [
    "plaintext",
    "markdown"
  ],
  "cursor.general.glassShowWarningNotifications": true,
  "editor.codeLensFontFamily": "Sarasa Mono K",
  "editor.fontFamily": "Sarasa Mono K",
  "editor.inlayHints.fontFamily": "Sarasa Mono K",
  "editor.inlineSuggest.fontFamily": "Sarasa Mono K",
  "editor.wordWrap": "on",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "git.autofetch": true,
  "git.confirmSync": false,
  "notebook.markup.fontFamily": "Sarasa Mono K",
  "notebook.output.fontFamily": "Sarasa Mono K",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontFamily": "Sarasa Mono K",
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.mouseWheelScrollSensitivity": 3,
  "window.autoDetectColorScheme": true,
  "window.confirmSaveUntitledWorkspace": false,
  "workbench.iconTheme": "material-icon-theme"
}
